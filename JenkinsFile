pipeline {
agent any 
stages{
stage('code pull'){
steps{
sh 'git clone https://github.com/aakashs3/terraform.git'
echo 'code pull suceessfull'
}
}
stage('code build'){
steps{
sh '''cd /var/lib/jenkins/workspace/project-01/terraform
cp instance instance.tf'''
echo 'code build successfull'
}
}
stage('code init'){
steps{
sh '''cd /var/lib/jenkins/workspace/project-01/terraform
      terraform init'''
echo 'code init successfull'
}
}
stage('code validate'){
steps{
sh '''cd /var/lib/jenkins/workspace/project-01/terraform
      terraform validate'''
echo 'code validate successfull'
}
}
