pipeline {
agent any 
stages{
stage('code pull'){
steps{
sh 'rm -rf /var/lib/jenkins/workspace/project-01/*'
sh 'git clone https://github.com/aakashs3/terraform.git'
echo 'code pull suceessfull'
}
}
stage('code build'){
steps{
sh 'cd /terraform'
sh 'mv vpc vpc.tf'
echo 'code build successfull'
}
}
stage('code deploy'){
steps{
echo 'code deploy successfull'
}
}
}
}
